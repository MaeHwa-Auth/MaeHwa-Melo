{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaeHwa Melo",
  "version": "0.5.4",
  "identifier": "studio.maehwa.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaeHwa Melo",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#11110f"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: blob:; connect-src ipc: http://ipc.localhost https://api.spotify.com https://accounts.spotify.com https://*.spotify.com wss://*.spotify.com https://lrclib.net; frame-src https://sdk.scdn.co https://*.spotify.com; worker-src 'self' blob:; script-src 'self' https://sdk.scdn.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/maehwa-melo.ico",
        "uninstallerIcon": "icons/maehwa-melo.ico",
        "languages": ["Korean"]
      }
    },
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/maehwa-melo.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QkIzMDE3NTU1Njk2RTgKUldUb2xsWlZGekM3MSttQ1pFcGpNWTZZR2h0Y3FhRTl6anpPSnFmdkJ4TkdtbkpKNThoaWNRSHAK",
      "endpoints": [
        "https://github.com/MaeHwa-Auth/MaeHwa-Melo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
